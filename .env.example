# Copy to .env and fill in. Never commit .env.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Comma-separated frontend origins, e.g. http://localhost or https://your-app.vercel.app
CORS_ORIGINS=http://localhost

# Passwords for the seeded demo accounts (production only; leave empty to disable them)
ADMIN_SEED_PASSWORD=
OFFICER_SEED_PASSWORD=
RESCUE_SEED_PASSWORD=
MEDICAL_SEED_PASSWORD=
RESIDENT_SEED_PASSWORD=
